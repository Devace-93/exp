# ─── exp environment ─────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# --- Core / database ---
DATABASE_URL=postgresql+psycopg://exp:exp@postgres:5432/exp
REDIS_URL=redis://redis:6379/0

# --- Identity (accounts.3m4.net) ---
# Sessions are issued by the shared accounts service; this app only verifies
# them (CONTRACT.md "Auth"). ACCOUNTS_URL = public origin (JWT issuer, login
# redirects, the browser's session calls). ACCOUNTS_INTERNAL_URL = where the
# api container fetches the JWKS; on the shared `edge` docker network that is
# the accounts api container, locally and in production alike.
ACCOUNTS_URL=http://localhost:8085                  # https://accounts.3m4.net in prod
ACCOUNTS_INTERNAL_URL=http://accounts-api-1:5000
# Behind Caddy the Qwik server must trust X-Forwarded-Proto, or SSR builds http://
# URLs (login redirects, return_to) that accounts rejects. Set in prod; harmless locally.
PROTOCOL_HEADER=x-forwarded-proto

# --- URLs ---
APP_BASE_URL=http://localhost:8081          # https://exp.3m4.net in prod
DASHBOARD_URL=http://localhost:8081         # same host as the apex (single-host app)

# --- Billing (payments.3m4.net). Self-host: set BILLING_ENABLED=false ---
# exp never calls Stripe. The hosted portal owns checkout, the Customer
# Portal, receipts and donations; exp only sends users there, receives its
# signed push webhooks (POST /api/billing/webhook) and pulls entitlements with
# a service key (nightly reconcile in the worker).
BILLING_ENABLED=true
# Public origin of the portal (hosted pages, supporters list). Prod: https://payments.3m4.net
PAYMENTS_URL=http://localhost:8086
# Where the api/worker containers reach the payments api: the payments api
# container on the shared `edge` docker network, locally and in prod alike.
PAYMENTS_INTERNAL_URL=http://payments-api-1:5000
# Both printed ONCE by `make app-key SLUG=exp WEBHOOK_URL=http://exp-api-1:5000/api/billing/webhook`
# in the payments repo (prod: the same command on the box; the webhook URL is
# the exp api container name, reachable from payments over `edge`).
PAYMENTS_SERVICE_KEY=
PAYMENTS_WEBHOOK_SECRET=

# --- PostHog (optional; no-ops if unset) ---
# Leave EMPTY locally and for self-host: no analytics calls, and exp's own
# feature switches resolve to their self-host values in
# packages/shared/feature_flags.json. Set only in production, where PostHog is
# the control panel. One PostHog project is shared with the other 3m4 apps, so
# every PostHog flag key is prefixed (POSTHOG_FLAG_PREFIX + key).
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_FLAG_PREFIX=exp-
# Pin individual switches from the environment, beating both PostHog and the
# self-host defaults. Comma-separated key=on|off, e.g.
# FEATURE_FLAG_OVERRIDES=site-building=on,signups=off
FEATURE_FLAG_OVERRIDES=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PUBLIC_API=60/minute
RATE_LIMIT_EVAL=600/minute

# --- Frontend (Vite, build-time). Prefix MUST be VITE_ ---
VITE_API_URL=http://localhost:8081/api
VITE_APP_URL=http://localhost:8081
# Same value as ACCOUNTS_URL (inlined into the web bundle)
VITE_ACCOUNTS_URL=http://localhost:8085
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Same value as PAYMENTS_URL (inlined into the web bundle: Upgrade / Manage /
# Donate buttons open the portal's hosted pages, pay.js is loaded from there)
VITE_PAYMENTS_URL=http://localhost:8086
VITE_BILLING_ENABLED=true
# Apps index linked from the footer (same across all 3m4 apps)
VITE_INFO_URL=https://info.3m4.net
# retro feedback widget (https://retro.3m4.net): the project's PUBLIC key. Empty = no widget.
VITE_RETRO_PROJECT_KEY=
VITE_RETRO_WIDGET_URL=https://retro.3m4.net/widget.js
# metrics web analytics (https://metrics.3m4.net): the project's PUBLIC key. Empty = no tracker.
VITE_METRICS_PROJECT_KEY=
VITE_METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# oops error tracking (https://oops.3m4.net): the project's PUBLIC key. Empty = no SDK.
VITE_OOPS_PROJECT_KEY=
VITE_OOPS_SDK_URL=https://oops.3m4.net/o.js
VITE_OOPS_ENV=production
